{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Digital marketplace product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "imageUrl": { "type": "string" },
        "features": { "type": "array" },
        "deliveryType": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSizeMb": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "totalSales": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer digital purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "bkashTrxId": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "totalAmount"]
    },
    "Config": {
      "title": "Config",
      "description": "System and bKash store configuration",
      "type": "object",
      "properties": {
        "receiverNumber": { "type": "string" },
        "accountType": { "type": "string" },
        "merchantName": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public marketplace products collection"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Catalog categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and digital delivery fulfillment"
    },
    "/settings/{settingId}": {
      "schema": "Config",
      "description": "Store settings and bKash receiver configuration"
    }
  }
}

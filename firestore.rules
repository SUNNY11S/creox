rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: Publicly readable for storefront, writable by admin/store
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Categories: Publicly readable, writable by store
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // Orders: Anyone can create on checkout; readable and manageable
    match /orders/{orderId} {
      allow read: if true;
      allow write: if isValidId(orderId);
    }

    // Store Settings (bKash config, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
